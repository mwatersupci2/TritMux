[PAIR_TABLE_RULE]
For every left symbol L in all banks and every right symbol R in all banks:

pair_id = left_global_index * 81 + right_global_index

splitTryte_lanes = [11|OPTIONS|BANK_L_BITS|VAL_L_BITS|BANK_R_BITS|VAL_R_BITS]

Global bank order:
0..26   = BANK:+
27..53  = BANK:-
54..80  = BANK:0

[PAIR_ID_LAYOUT]
left_global_index  = pair_id / 81
right_global_index = pair_id % 81

global_symbol_index:
00..26 = BANK:+ values 00..26
27..53 = BANK:- values 00..26
54..80 = BANK:0 values 00..26

